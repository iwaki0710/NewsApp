# Copy this file to .env.local and add your API keys.
# Never prefix this variable with NEXT_PUBLIC_.
NEWSDATA_API_KEY=

# DeepL API Developer / API Free authentication key.
DEEPL_API_KEY=

# Supabase Auth public project settings. These values are intentionally safe
# to expose to the browser; never use the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
